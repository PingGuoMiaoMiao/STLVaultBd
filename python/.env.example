# 和 Nest 版共用同一个 PostgreSQL，只是驱动换成 asyncpg
DATABASE_URL="postgresql://stlvault:stlvault_pg_9x4Qm2@127.0.0.1:5432/stlvault?schema=public"

# JWT 密钥必须和 Nest 版一致，否则两边签发的 token 互相验不了
JWT_SECRET="stlvault-dev-secret-please-change-in-production"

# 服务端口与跨域
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# SMTP：留空则验证码只打印到终端，方便本地调试
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-number@qq.com
SMTP_PASS=your-smtp-authorization-code
MAIL_FROM="STLVault <your-qq-number@qq.com>"
